//kage:unit texels
package main

var Smoothing float // 0=Hard; 1=Smooth; 2=Glow etc

// Uniforms:
//  ViewX, ViewY, ViewWidth, ViewHight
//  BlurX, BlurY
//  Gamma, Saturation, Brightness, Contrast, Grayscale

// texCoord.x | CenterX
// texCoord.y | CenterY
// color.r    | Width
// color.g    | Height
// color.b    | Tint         (packed RGBA, 6 bits per channel)
// color.a    | Kind

// Shape/Image:
//  custom.x | Roundness
//  custom.y | OutlineColor  (packed RGBA, 6 bits per channel)
//  custom.z | OutlineSize
//  custom.w |

// Text:
//  custom.x |
//  custom.y |
//  custom.z |
//  custom.w |

// Tilemap:
//  custom.x | TileSize
//  custom.y | TileRows
//  custom.z | TileColumns
//  custom.w |

func unpackColor(packed float) vec4 {
	r := floor(packed / 262144.0)
	g := floor(mod(packed, 262144.0) / 4096.0)
	b := floor(mod(packed, 4096.0) / 64.0)
	a := mod(packed, 64.0)
	return vec4(r, g, b, a) / 63.0
}

func Fragment(position vec4, texCoord vec2, color vec4, custom vec4) vec4 {
    width, height := color.r, color.g
    fillColor := unpackColor(color.b)
    roundness, outlineSize := custom.x, custom.z
    outlineColor := unpackColor(custom.y)
    
    origin, size := imageSrc0Origin(), imageSrc0Size()
    uv := (texCoord - origin) / size 
    halfSize := vec2(width, height) * 0.5
    pLocal := (uv - 0.5) * vec2(width, height)
    
    maxRadius := min(halfSize.x, halfSize.y)
    radius := abs(roundness) * maxRadius
    
    q := abs(pLocal) - halfSize + radius
    dShape := length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius

    if roundness < 0.0 {
        dShape = max(radius - length(max(q, 0.0)), max(abs(pLocal).x - halfSize.x, abs(pLocal).y - halfSize.y))
    }
    
    dEdge := dShape
    if outlineSize != 0.0 {
        hOut := halfSize + abs(outlineSize)
        rOut := abs(roundness) * min(hOut.x, hOut.y)
        qOut := abs(pLocal) - hOut + rOut
        dEdge = length(max(qOut, 0.0)) + min(max(qOut.x, qOut.y), 0.0) - rOut
    }

    af := fwidth(dShape) * Smoothing
    
    sShape := 1.0 - smoothstep(-af, af, dShape)
    sEdge := 1.0 - smoothstep(-af, af, dEdge)

    finalFillColor := imageSrc0At(texCoord) * fillColor
    
    var res vec4
    if outlineSize > 0.0 {
        res = mix(outlineColor, finalFillColor, sShape)
        return res * sEdge
    } else if outlineSize < 0.0 {
        res = mix(finalFillColor, outlineColor, 1.0 - sEdge)
        return res * sShape
    }

    return finalFillColor * sShape
}