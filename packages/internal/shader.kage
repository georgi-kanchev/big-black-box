//kage:unit texels
package main

// Uniforms:
//  ViewX, ViewY, ViewWidth, ViewHight
//  BlurX, BlurY
//  Gamma, Saturation, Brightness, Contrast, Grayscale

// texCoord.x | CenterX
// texCoord.y | CenterY
// color.r    | Width
// color.g    | Height
// color.b    | Rotation
// color.a    | Tint         (packed RGBA, 6 bits per channel)

// Shape/Image:
//  custom.x | Roundness
//  custom.y | OutlineColor  (packed RGBA, 6 bits per channel)
//  custom.z | OutlineSize
//  custom.w | -

// Text:
//  custom.x | SymbolGap
//  custom.y | LineGap
//  custom.z | LineHeight
//  custom.w | Align (bits [2:0], 0-7) + WordWrap (bit [3])

// TileMap:
//  custom.x | TileSize
//  custom.y | TileRows
//  custom.z | TileColumns
//  custom.w | -

// unpackColor decodes a 24-bit packed float into a normalized vec4.
// Packing layout: R6[23:18] G6[17:12] B6[11:6] A6[5:0], 6 bits per channel.
func unpackColor(packed float) vec4 {
	r := floor(packed / 262144.0)
	g := floor(mod(packed, 262144.0) / 4096.0)
	b := floor(mod(packed, 4096.0) / 64.0)
	a := mod(packed, 64.0)
	return vec4(r, g, b, a) / 63.0
}

func Fragment(position vec4, texCoord vec2, color vec4, custom vec4) vec4 {
    width, height := color.r, color.g
    fillColor := unpackColor(color.a)
    roundness, outlineSize := custom.x, custom.z
    outlineColor := unpackColor(custom.y)
    origin, size := imageSrc0Origin(), imageSrc0Size()
    uv := (texCoord - origin) / size 
    halfSize := vec2(width, height) * 0.5
    pLocal := (uv - 0.5) * vec2(width, height)
    maxRadius := min(halfSize.x, halfSize.y)
    radius := abs(roundness) * maxRadius
    q := abs(pLocal) - halfSize + radius
    dShape := length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius

    if roundness < 0.0 {
        dShape = max(radius - length(max(q, 0.0)), max(abs(pLocal).x - halfSize.x, abs(pLocal).y - halfSize.y))
    }
    
    dOut := dShape
    if outlineSize != 0.0 {
        hOut := max(halfSize + outlineSize, 0.0)
        rOut := abs(roundness) * min(hOut.x, hOut.y)
        qOut := abs(pLocal) - hOut + rOut
        dOut = length(max(qOut, 0.0)) + min(max(qOut.x, qOut.y), 0.0) - rOut
        if roundness < 0.0 {
            dOut = max(rOut - length(max(qOut, 0.0)), max(abs(pLocal).x - hOut.x, abs(pLocal).y - hOut.y))
        }
    }
    
    sShape := step(dShape, 0.0)
    sOut := step(dOut, 0.0)

    totalAlpha, fillAlpha := sShape, sShape
    if outlineSize > 0.0 {
        totalAlpha, fillAlpha = sOut, sShape
    } else if outlineSize < 0.0 {
        totalAlpha, fillAlpha = sShape, sOut
    }
    
    finalFillColor := imageSrc0At(texCoord) * fillColor
    return mix(outlineColor, finalFillColor, fillAlpha) * totalAlpha
}
